# Copy to deploy.local.env (ignored). Values already set in the shell take precedence.
# SSH config aliases work; never put passwords or private keys in this file.
DOKE_HOST="${DOKE_HOST:-user@your-server}"
DOKE_CONTAINER="${DOKE_CONTAINER:-doke}"
DOKE_ROOT="${DOKE_ROOT:-/opt/doke}"
DOKE_HEALTH_PORT="${DOKE_HEALTH_PORT:-8089}"
